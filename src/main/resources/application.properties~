spring.application.name=furniture-home
spring.datasource.url=jdbc:mysql://localhost:3306/furniture_home?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=123456
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
server.port=8080

# location to store uploaded files (relative to app working dir or absolute)
app.upload.dir=uploads

# Recommended: bump multipart sizes if you expect big images
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=20MB
